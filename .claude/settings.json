{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "defaultMode": "acceptEdits",
    "allow": [
      "Bash(gcc *)",
      "Bash(make *)",
      "Bash(mingw32-make *)",
      "Bash(mktemp *)",
      "Bash(git status*)",
      "Bash(git diff*)",
      "Bash(git log*)",
      "Bash(git show*)",
      "Bash(git archive *)",
      "Bash(git add *)",
      "Bash(git checkout -- data)",
      "Bash(git commit *)",
      "Bash(git fetch*)",
      "Bash(git ls-remote*)",
      "Bash(gh run list*)",
      "Bash(gh run view*)",
      "Bash(gh run watch*)",
      "Edit(.github/**)"
    ],
    "ask": [
      "Edit(.claude/**)",
      "Edit(AGENTS.md)"
    ],
    "deny": [
      "Bash(git push*)",
      "Bash(git reset --hard*)",
      "Bash(git rebase*)",
      "Bash(git stash*)",
      "Bash(git switch*)",
      "Bash(git checkout -b*)",
      "Bash(git commit -a*)",
      "Bash(git commit --amend*)",
      "Bash(git commit *--amend*)",
      "Bash(git commit * -a*)",
      "Bash(git commit *--all*)",
      "Bash(git add -A*)",
      "Bash(git add --all*)",
      "Bash(git add .)",
      "Bash(git add data*)",
      "Edit(data/**)",
      "Edit(BRIEF.md)",
      "Edit(TICKET-*.md)"
    ]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "cd \"$CLAUDE_PROJECT_DIR\" && gcc -Wall -Wextra -Werror -fsyntax-only *.c || exit 2",
            "timeout": 30,
            "statusMessage": "Linting C files"
          }
        ]
      }
    ]
  }
}
